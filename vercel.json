{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/preferences",  "destination": "/preferences.html" },
    { "source": "/success",      "destination": "/success.html" },
    { "source": "/privacy",      "destination": "/privacy.html" },
    { "source": "/unsubscribe",  "destination": "/unsubscribe.html" }
  ],
  "crons": [
    { "path": "/api/webhook_social",  "schedule": "0 6 * * *"   },
    { "path": "/api/webhook_preview", "schedule": "0 6 * * 1"  },
    { "path": "/api/webhook_digest",  "schedule": "0 12 * * 1"  },
    { "path": "/api/webhook_post",    "schedule": "0 12 * * *" }
  ]
}
